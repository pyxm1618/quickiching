# ---- Server-only (never expose to client) ----
NODE_ENV=development
# Optional explicit build/runtime profile: development | test | production
APP_RUNTIME_MODE=development
APP_BASE_URL=http://localhost:3000

# Explicit local adapter modes. Production requires the corresponding production mode.
AUTH_ADAPTER_MODE=dev
PAYMENT_ADAPTER_MODE=simulated
DATABASE_ADAPTER_MODE=memory
WORKFLOW_ADAPTER_MODE=local

# AI adapter mode: "local" (deterministic offline) or "ai-sdk" (production)
AI_ADAPTER_MODE=local
AI_MODEL_PREVIEW=
AI_MODEL_DEEP_READING=
AI_MODEL_OUTPUT_REVIEW=

# Production-only adapter credentials
DATABASE_URL=
BETTER_AUTH_SECRET=
AI_GATEWAY_API_KEY=
CREEM_API_KEY=
CREEM_WEBHOOK_SECRET=
CREEM_PRODUCT_ID_ONE=
CREEM_PRODUCT_ID_THREE=
CREEM_PRODUCT_ID_FIVE=
CRON_SECRET=

# Auth provider and email-delivery configuration
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
RESEND_API_KEY=
EMAIL_FROM=

# Production-only key rotation sets. Format: version:key,version:key
# Every purpose has one explicit cluster-wide write version and one or more readable versions.
# Keep QUESTION_FINGERPRINT_WRITE_VERSION stable for at least the 72-hour lock window.
# Each key value must be unique across all four purposes.
SESSION_SIGNING_KEYS=
SESSION_SIGNING_WRITE_VERSION=
QUESTION_FINGERPRINT_KEYS=
QUESTION_FINGERPRINT_WRITE_VERSION=
QUESTION_ENCRYPTION_KEYS=
QUESTION_ENCRYPTION_WRITE_VERSION=
RESULT_INTEGRITY_KEYS=
RESULT_INTEGRITY_WRITE_VERSION=

# Production-only adapter modes
# AI_ADAPTER_MODE=ai-sdk
# AUTH_ADAPTER_MODE=better-auth
# PAYMENT_ADAPTER_MODE=creem
# DATABASE_ADAPTER_MODE=postgres
# WORKFLOW_ADAPTER_MODE=vercel

# Bot protection
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ---- Public ----
NEXT_PUBLIC_APP_URL=http://localhost:3000

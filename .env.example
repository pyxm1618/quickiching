# ---- Server-only (never expose to client) ----
NODE_ENV=development
APP_BASE_URL=http://localhost:3000

# Explicit local adapter modes. Production requires the corresponding production mode.
AUTH_ADAPTER_MODE=dev
PAYMENT_ADAPTER_MODE=simulated
DATABASE_ADAPTER_MODE=memory
WORKFLOW_ADAPTER_MODE=local

# AI adapter mode: "local" (deterministic offline) or "ai-sdk" (production)
AI_ADAPTER_MODE=local
AI_MODEL_PREVIEW=
AI_MODEL_DEEP_READING=
AI_MODEL_OUTPUT_REVIEW=

# Production-only adapter credentials
DATABASE_URL=
BETTER_AUTH_SECRET=
AI_GATEWAY_API_KEY=
CREEM_API_KEY=
CREEM_WEBHOOK_SECRET=
CREEM_PRODUCT_ID_ONE=
CREEM_PRODUCT_ID_THREE=
CREEM_PRODUCT_ID_FIVE=

# Auth provider and email-delivery configuration
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
RESEND_API_KEY=
EMAIL_FROM=

# Production-only key rotation sets. Format: version:key,version:key
# Each key's value must be unique across all four purposes.
SESSION_SIGNING_KEYS=
QUESTION_FINGERPRINT_KEYS=
QUESTION_ENCRYPTION_KEYS=
RESULT_INTEGRITY_KEYS=

# Production-only adapter modes
# AI_ADAPTER_MODE=ai-sdk
# AUTH_ADAPTER_MODE=better-auth
# PAYMENT_ADAPTER_MODE=creem
# DATABASE_ADAPTER_MODE=postgres
# WORKFLOW_ADAPTER_MODE=vercel

# Bot protection
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ---- Public ----
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional analytics overrides. Quick I Ching's reviewed GA4/Clarity public IDs are
# built into the Vercel-production path; local and Preview remain disabled by default.
# These values are public browser identifiers, not secrets.
# GA4 Measurement ID format: G-XXXXXXXXXX
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Microsoft Clarity Project ID from Project Settings -> Overview / Setup.
NEXT_PUBLIC_CLARITY_PROJECT_ID=

# Adsterra result-page native unit. Keep false until a separate ad-launch review
# approves production enablement.
NEXT_PUBLIC_ADSTERRA_ENABLED=false

# ---- Server-only (never expose to client) ----
NODE_ENV=development
APP_BASE_URL=http://localhost:3000

# Commercial V2 server-side capability switches. Every capability is closed by
# default; these flags never use NEXT_PUBLIC_* and do not grant client authority.
COMMERCIAL_V2_AUTH_ENABLED=false
COMMERCIAL_V2_AI_PREVIEW_ENABLED=false
COMMERCIAL_V2_CHECKOUT_ENABLED=false
COMMERCIAL_V2_WEBHOOK_INGESTION_ENABLED=false
COMMERCIAL_V2_PAID_DEEP_READING_ENABLED=false
COMMERCIAL_V2_RECONCILE_ENABLED=false

# Explicit local adapter modes. Production requires the corresponding production mode.
AUTH_ADAPTER_MODE=dev
PAYMENT_ADAPTER_MODE=simulated
DATABASE_ADAPTER_MODE=memory
WORKFLOW_ADAPTER_MODE=local

# AI adapter mode: "local" (deterministic offline) or "ai-sdk" (production)
AI_ADAPTER_MODE=local
AI_MODEL_PREVIEW=
AI_MODEL_DEEP_READING=
AI_MODEL_OUTPUT_REVIEW=
AI_GATEWAY_BASE_URL=https://ai-gateway.vercel.sh/v1
PERSONALIZED_INTERPRETATION_ENABLED=false
NEXT_PUBLIC_PERSONALIZED_INTERPRETATION_ENABLED=false

# Production-only adapter credentials
DATABASE_URL=
BETTER_AUTH_SECRET=
AI_GATEWAY_API_KEY=
# Production personalized interpretation uses Upstash Redis for an atomic,
# cross-instance 5 requests/minute limit. The REST URL must end in .upstash.io.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Waffo is the approved payment target. CP1 defines the server-side contract
# only; no Waffo SDK/API call is made in this checkpoint.
WAFFO_MERCHANT_ID=
WAFFO_PRIVATE_KEY=
WAFFO_ENVIRONMENT=test
WAFFO_STORE_ID=
WAFFO_PRODUCT_ID_ONE=
WAFFO_PRODUCT_ID_THREE=
WAFFO_PRODUCT_ID_FIVE=

# Auth provider and email-delivery configuration
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
RESEND_API_KEY=
EMAIL_FROM=

# Production-only key rotation sets. Format: version:key,version:key
# Each key's value must be unique across all four purposes.
SESSION_SIGNING_KEYS=
QUESTION_FINGERPRINT_KEYS=
QUESTION_ENCRYPTION_KEYS=
RESULT_INTEGRITY_KEYS=

# Production-only adapter modes
# AI_ADAPTER_MODE=ai-sdk
# AUTH_ADAPTER_MODE=better-auth
# PAYMENT_ADAPTER_MODE=waffo
# DATABASE_ADAPTER_MODE=postgres
# WORKFLOW_ADAPTER_MODE=vercel

# Bot protection
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_ALLOWED_HOSTNAMES=www.quickiching.com

# ---- Public ----
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional analytics overrides. Quick I Ching's reviewed GA4/Clarity public IDs are
# built into the Vercel-production path; local and Preview remain disabled by default.
# These values are public browser identifiers, not secrets.
# GA4 Measurement ID format: G-XXXXXXXXXX
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Microsoft Clarity Project ID from Project Settings -> Overview / Setup.
NEXT_PUBLIC_CLARITY_PROJECT_ID=

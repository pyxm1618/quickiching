{
  "version": 1,
  "tooling": {
    "lighthouse": "13.4.1",
    "puppeteerCore": "25.1.0",
    "chromium": "149.0.0",
    "chromePolicy": "Pinned @sparticuz/chromium executable; record browser version in CI"
  },
  "regressionTolerance": {
    "performancePoints": 5,
    "lcpPercent": 10,
    "lcpAllowanceMs": 100
  },
  "defaults": {
    "accessibilityMin": 90,
    "seoMin": 90,
    "clsMax": 0.1,
    "tbtMaxMs": 200
  },
  "targets": {
    "home.mobile": {
      "path": "/",
      "device": "mobile",
      "metrics": {
        "performanceMin": 90,
        "lcpMaxMs": null,
        "accessibilityMin": 90,
        "seoMin": 90,
        "clsMax": 0.1,
        "tbtMaxMs": 200,
        "imageBytesMax": 786432,
        "maxImageBytesMax": 262144,
        "scriptBytesMax": 327680
      },
      "samplePolicy": {
        "count": 3,
        "selection": "median-performance-lcp-worst-rest",
        "warmupCount": 1
      },
      "baseline": {
        "file": "docs/performance/home-mobile-accepted-baseline.json",
        "key": "aggregate"
      }
    },
    "home.desktop": {
      "path": "/",

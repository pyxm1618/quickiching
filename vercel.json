{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "git": {
    "deploymentEnabled": {
      "**": false,
      "main": true,
      "staging": true
    }
  },
  "installCommand": "bunx bun@1.3.14 install --frozen-lockfile",
  "buildCommand": "bun run build:vercel",
  "crons": [
    {
      "path": "/api/internal/reconcile",
      "schedule": "0 0 * * *"
    }
  ]
}
